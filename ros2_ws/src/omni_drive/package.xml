<?xml version="1.0"?>
<package format="3">
  <name>omni_drive</name>
  <version>0.1.0</version>
  <description>Standalone joystick-controlled holonomic drive using the unmodified Robocon R2 Blitz sender and Raspberry Pi Pico firmware.</description>
  <maintainer email="user@example.com">local project</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_interfaces</exec_depend>
  <exec_depend>blitz_drive</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
